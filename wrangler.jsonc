{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elevenlabs-transcription-workbench",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/downloads/*", "/healthz"]
  },

  // Created with: wrangler d1 create workbench
  // Paste the returned database_id below before deploying.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workbench",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Created with: wrangler r2 bucket create workbench-transcripts
  "r2_buckets": [
    {
      "binding": "TRANSCRIPTS",
      "bucket_name": "workbench-transcripts"
    }
  ],

  // Created with:
  //   wrangler queues create transcription-jobs
  //   wrangler queues create transcription-jobs-dlq
  "queues": {
    "producers": [
      {
        "queue": "transcription-jobs",
        "binding": "JOB_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "transcription-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 1,
        "max_concurrency": 10,
        "dead_letter_queue": "transcription-jobs-dlq"
      }
    ]
  }
}
